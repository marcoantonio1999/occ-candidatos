{
  "manifest_version": 3,
  "name": "Candidatos BPower · Captura manual",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Agrega el perfil abierto con un clic. Guarda localmente y exporta Excel. Sin navegación automática ni envíos a servidores.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_title": "Agregar candidato abierto", "default_popup": "panel.html"},
  "options_page": "panel.html",
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
